# Staging values for .github/workflows/e2e-staging.yml.
# The workflow copies this file to .env before the production build and start.
# Public values only. Set HOMESERVER_ADMIN_PASSWORD in the environment
# (CI uses the STAGING_HOMESERVER_ADMIN_PASSWORD secret). Cypress sends it
# as the X-Admin-Password header and never reads it from this file.

PUBKY_RUNTIME_ENV=staging
PUBKY_RUNTIME_NEXUS_URL=https://nexus.staging.pubky.app
PUBKY_RUNTIME_CDN_URL=https://nexus.staging.pubky.app/static
PUBKY_RUNTIME_HOMESERVER=ufibwbmed6jeq9k4p583go95wofakh9fwpp4k734trq79pd9u1uy
PUBKY_RUNTIME_HOMESERVER_URL=https://homeserver.staging.pubky.app
PUBKY_RUNTIME_HOMEGATE_URL=https://homegate.staging.pubky.app
PUBKY_RUNTIME_DEFAULT_HTTP_RELAY=https://httprelay.staging.pubky.app/inbox
PUBKY_RUNTIME_PKARR_RELAYS=["https://pkarr.pubky.app","https://pkarr.pubky.org"]
# false selects the default mainnet Pubky client for Cypress seed (public PKARR relays).
# Local e2e leaves this unset and keeps Pubky.testnet('localhost').
PUBKY_RUNTIME_TESTNET=false
# Shorter than the 8888ms app default so specs are not waiting on poll ticks.
PUBKY_RUNTIME_NOTIFICATION_POLL_INTERVAL_MS=2000

# Cypress reads this from .env (cypress/cypress.config.ts).
HOMESERVER_ADMIN_URL=https://admin.homeserver.staging.pubky.app/generate_signup_token
