// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`PostContentBase - Snapshots > matches snapshot with empty content 1`] = `null`;

exports[`PostContentBase - Snapshots > matches snapshot with loading state 1`] = `
<div
  class="flex min-w-0 flex-col gap-y-1"
  data-testid="container"
>
  <div
    class="h-4 w-full rounded-md"
    data-testid="skeleton"
  />
  <div
    class="h-4 w-4/5 rounded-md"
    data-testid="skeleton"
  />
  <div
    class="h-4 w-3/5 rounded-md"
    data-testid="skeleton"
  />
</div>
`;

exports[`PostContentBase - Snapshots > matches snapshot with multiline content (preserves newlines) 1`] = `
<div
  class="min-w-0 gap-3"
  data-testid="container"
>
  <div
    class="text-base leading-6 font-medium wrap-anywhere whitespace-pre-line text-secondary-foreground"
    data-testid="container"
  >
    <p>
      Line 1
Line 2
    </p>
    

    <p>
      Line 3
    </p>
  </div>
  <div
    data-testid="post-attachments"
  />
</div>
`;

exports[`PostContentBase - Snapshots > matches snapshot with single-line content 1`] = `
