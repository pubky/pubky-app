// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`DialogEditPost - Snapshots > matches snapshot for long post (Edit Article) 1`] = `
<div
  data-open="true"
  data-testid="dialog"
>
  <div
    aria-label="Edit Article"
    class="w-3xl"
    data-testid="dialog-content"
  >
    <div
      data-testid="dialog-header"
    >
      <h2
        data-testid="dialog-title"
      >
        Edit Article
      </h2>
      <p
        class="sr-only"
        data-testid="dialog-description"
      >
        Edit Article
         dialog
      </p>
    </div>
    <div
      data-cy="edit-post-input"
      data-edit-attachments=""
      data-edit-content="{\\"title\\":\\"Snapshot article title\\",\\"body\\":\\"Snapshot article content\\"}"
      data-edit-is-article="true"
      data-edit-post-id="snapshot-article-id"
      data-expanded="true"
      data-layout-override="inline"
      data-testid="post-input"
      data-variant="edit"
    >
      <button
        data-testid="mock-success-btn"
      >
        Success
      </button>
      <button
        data-testid="mock-content-change-btn"
      >
        Change Content
      </button>
    </div>
    <div
      data-open="false"
      data-testid="dialog-confirm-discard"
    >
      <button
        data-testid="mock-confirm-btn"
      >
        Confirm
      </button>
      <button
        data-testid="mock-cancel-btn"
      >
        Cancel
      </button>
    </div>
  </div>
</div>
`;

exports[`DialogEditPost - Snapshots > matches snapshot for short post (Edit Post) 1`] = `
<div
  data-open="true"
  data-testid="dialog"
>
  <div
    aria-label="Edit Post"
    class="w-3xl"
    data-testid="dialog-content"
  >
    <div
      data-testid="dialog-header"
    >
