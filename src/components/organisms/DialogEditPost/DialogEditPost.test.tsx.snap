        data-testid="dialog-title"
      >
        Edit Post
      </h2>
      <p
        class="sr-only"
        data-testid="dialog-description"
      >
        Edit Post
         dialog
      </p>
    </div>
    <div
      data-cy="edit-post-input"
      data-edit-attachments="pubky://author/pub/pubky.app/files/snapshot-file-1"
      data-edit-content="Snapshot post content"
      data-edit-is-article="false"
      data-edit-post-id="snapshot-post-id"
      data-expanded="true"
      data-layout-override="inline"
      data-testid="post-input"
      data-variant="edit"
