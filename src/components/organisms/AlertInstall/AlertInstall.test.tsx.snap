exports[`AlertInstall - Snapshots > matches snapshot for the native install banner 1`] = `
<div>
  <div
    aria-label="Install Pubky"
    class="mx-auto w-full flex flex-row items-center gap-3 rounded-lg bg-brand px-6 py-3"
    data-testid="alert-install"
    role="region"
  >
    <div
      class="mx-auto w-full flex min-w-0 flex-1 flex-row items-center gap-3"
      data-testid="container"
    >
      <svg
        aria-hidden="true"
        class="lucide lucide-smartphone size-4 shrink-0 text-primary-foreground"
        fill="none"
        height="24"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <rect
          height="20"
          rx="2"
          ry="2"
          width="14"
          x="5"
          y="2"
        />
        <path
          d="M12 18h.01"
        />
      </svg>
      <p
        class="text-sm truncate font-bold text-primary-foreground"
        data-testid="typography"
      >
        <span
          class="md:hidden"
        >
          Install Pubky
        </span>
        <span
          class="hidden md:inline"
        >
          Install Pubky for faster access
        </span>
      </p>
    </div>
    <div
      class="flex shrink-0 items-center gap-3"
    >
      <button
        class="inline-flex items-center justify-center whitespace-nowrap transition-all disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg:not([class*=\\"size-\\"])]:size-4 shrink-0 [&_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/40 aria-invalid:border-destructive cursor-pointer rounded-full border shadow-xs hover:text-white border-neutral-700 hover:bg-neutral-800 h-8 gap-1.5 has-[>svg]:px-3.5 bg-input/30 px-3.5 text-xs font-bold text-primary-foreground"
        data-size="sm"
        data-slot="button"
        data-variant="dark-outline"
      >
        Later
      </button>
      <button
        class="inline-flex items-center justify-center whitespace-nowrap transition-all disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg:not([class*=\\"size-\\"])]:size-4 shrink-0 [&_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/40 aria-invalid:border-destructive cursor-pointer rounded-full border shadow-xs text-foreground hover:bg-muted h-8 gap-1.5 has-[>svg]:px-3.5 border-card bg-card px-3.5 text-xs font-bold"
        data-size="sm"
        data-slot="button"
        data-variant="dark"
      >
        Install
      </button>
    </div>
  </div>
  <div
    data-open="false"
    data-testid="dialog-install-ios"
  >
    <button
      data-testid="dialog-install-ios-close"
      type="button"
    >
      close
    </button>
    <button
      data-testid="dialog-install-ios-confirm"
      type="button"
    >
      confirm
    </button>
  </div>
</div>
`;

