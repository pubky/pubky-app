exports[`PassportMethodCard > renders the Quick & Easy card with the cloud illustration and forwards the click 1`] = `
<div>
  <div
    class="flex flex-col bg-card text-card-foreground shadow-sm gap-0 p-6 lg:p-12 flex-1 rounded-md"
    data-slot="card"
    data-testid="passport-method-card"
  >
    <div
      class="flex w-full gap-4 lg:items-start lg:gap-12 flex-col lg:flex-row p-0"
      data-slot="card-content"
    >
      <div
        class="hidden w-48 shrink-0 flex-col lg:flex"
        data-slot="illustrated-card-visual"
      >
        <img
          alt="Lime cloud representing an account backed by an existing sign-in provider"
          class="max-w-full size-48"
          height="192"
          src="/images/passport-cloud.webp"
          width="192"
        />
      </div>
      <div
        class="flex w-full max-w-xl min-w-0 flex-1 flex-col gap-6"
        data-slot="illustrated-card-content"
      >
        <div
          class="mx-auto w-full flex-col flex gap-3"
          data-testid="container"
        >
          <h3
            class="text-2xl font-bold text-foreground leading-8"
            data-testid="typography"
          >
            Quick & Easy
          </h3>
          <p
            class="text-base font-medium leading-6 text-secondary-foreground/80"
            data-testid="typography"
          >
            Use your existing sign-in methods.
          </p>
        </div>
        <button
          aria-busy="false"
          class="inline-flex items-center justify-center whitespace-nowrap transition-all disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg:not([class*=\\"size-\\"])]:size-4 shrink-0 [&_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/40 aria-invalid:border-destructive cursor-pointer rounded-full border shadow-xs bg-secondary text-secondary-foreground hover:bg-accent h-auto gap-2 px-8 py-5 text-sm font-bold leading-normal w-full"
          data-size="lg"
          data-slot="button"
          data-testid="continue-with-google"
          data-variant="secondary"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="size-4"
            fill="none"
            height="24"
            viewBox="0 0 16 16"
            width="24"
            xmlns="http://www.w3.org/2000/svg"
          >
