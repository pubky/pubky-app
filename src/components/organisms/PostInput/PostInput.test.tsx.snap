    data-testid="input"
    placeholder="Title"
    value="Existing Article Title"
  />
  <div
    class="min-w-0 contain-inline-size rounded-md border border-dashed transition-colors duration-200 p-6 border-input [&_textarea::placeholder]:transition-opacity [&_textarea::placeholder]:duration-150 focus-within:[&_textarea::placeholder]:opacity-0 motion-reduce:[&_textarea::placeholder]:transition-none"
    data-testid="container"
  >
    <div
      class="overflow-hidden"
      data-testid="post-input-state-height"
      style="height: auto;"
    >
      <div
        class="relative"
      >
        <div
          class="relative flex min-w-0 flex-col gap-4"
          data-testid="post-input-state-content"
        >
          <div
            aria-labelledby="radix-normalized-trigger-content"
            class="outline-none data-[state=inactive]:hidden"
            data-orientation="horizontal"
            data-slot="tabs-content"
            data-state="active"
            data-testid="article-composer-panel-content"
            id="radix-normalized-content-content"
            role="tabpanel"
            style="animation-duration: 0s;"
            tabindex="-1"
          >
            <div
              contenteditable="true"
              data-readonly="false"
              data-testid="markdown-editor"
            >
              Existing article body
            </div>
          </div>
          <div
            aria-labelledby="radix-normalized-trigger-header"
            class="outline-none data-[state=inactive]:hidden"
            data-orientation="horizontal"
            data-slot="tabs-content"
            data-state="inactive"
            data-testid="article-composer-panel-header"
            id="radix-normalized-content-header"
            role="tabpanel"
            tabindex="-1"
          >
            <div
              data-existing-count="0"
              data-is-article="true"
              data-submitting="false"
              data-testid="post-input-attachments"
            >
              <button
                data-testid="attachment-button"
              >
                Attach
              </button>
            </div>
          </div>
          <div
            aria-labelledby="radix-normalized-trigger-preview"
            class="outline-none"
            data-orientation="horizontal"
            data-slot="tabs-content"
            data-state="inactive"
            data-testid="article-composer-panel-preview"
            hidden=""
            id="radix-normalized-content-preview"
            role="tabpanel"
            tabindex="-1"
          />
          <div
            data-testid="post-input-expanded-controls"
            style="opacity: 1; filter: blur(0px);"
          >
            <div
              class="gap-4"
              data-testid="container"
            >
              <div
                data-disabled="true"
                data-testid="post-input-tags"
              />
              <div
                data-post-disabled="false"
                data-testid="post-input-action-bar"
              >
                <span
                  class="relative flex shrink-0 overflow-hidden rounded-full h-8 w-8"
                  data-testid="article-composer-avatar"
                >
                  <span
                    class="flex h-full w-full items-center justify-center rounded-full border border-muted-foreground bg-muted overflow-hidden border-none"
                  >
                    <div
                      class="facehash h-full w-full rounded-full text-background"
                      data-facehash=""
                      data-interactive="true"
                      style="width: 100%; height: 100%; position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden; container-type: size; perspective: 300px; transform-style: preserve-3d; background-color: rgb(0, 75, 255);"
                    >
                      <div
                        data-facehash-gradient=""
                        style="position: absolute; inset: 0px; pointer-events: none; z-index: 1; background: radial-gradient(100% 100% at 50% 50%, rgba(255, 255, 255, 0.15) 0%, transparent 60%);"
                      />
                      <div
                        data-facehash-face=""
                        style="position: absolute; inset: 0px; display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 2; transform: rotateX(15deg) rotateY(-15deg) translateZ(12px); transform-style: preserve-3d; transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);"
                      >
                        <svg
                          aria-hidden="true"
                          fill="none"
                          style="width: 60%; height: auto; max-width: 90%; max-height: 40%;"
                          viewBox="0 0 82 8"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <g
                            style="animation: facehash-blink 2.2s ease-in-out 0.2s infinite; transform-origin: center center;"
                          >
                            <rect
                              fill="currentColor"
                              height="6.9"
                              rx="3.5"
                              width="6.9"
                              x="0.07"
                              y="0.16"
                            />
                            <rect
                              fill="currentColor"
                              height="6.9"
                              rx="3.5"
                              width="20.7"
                              x="7.9"
                              y="0.16"
                            />
                          </g>
                          <g
                            style="animation: facehash-blink 2.2s ease-in-out 0.2s infinite; transform-origin: center center;"
                          >
                            <rect
                              fill="currentColor"
                              height="6.9"
                              rx="3.5"
                              width="6.9"
                              x="74.7"
                              y="0.16"
                            />
                            <rect
                              fill="currentColor"
                              height="6.9"
                              rx="3.5"
                              width="20.7"
                              x="53.1"
                              y="0.16"
                            />
                          </g>
                        </svg>
                        <div
                          data-facehash-mouth=""
                          style="margin-top: 8%; display: flex; align-items: center; justify-content: center;"
                        >
                          <span
                            data-as="span"
                            data-testid="avatar-fallback-initial"
                          >
                            C
                          </span>
                        </div>
                      </div>
                    </div>
                  </span>
                </span>
                <button
                  aria-label="Enter fullscreen"
                  aria-pressed="false"
                  data-testid="fullscreen-button"
                >
                  Fullscreen
                </button>
                <button
                  aria-label="Add emoji"
                  data-testid="emoji-button"
                >
                  Emoji
                </button>
                <button
                  aria-label="Add image"
                  data-testid="image-button"
                >
                  Image
                </button>
                <button
                  aria-label="Add article"
                  data-testid="article-button"
                >
                  Article
                </button>
                <button
                  aria-label="Post"
                  data-testid="post-button"
                >
                  Post
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;

