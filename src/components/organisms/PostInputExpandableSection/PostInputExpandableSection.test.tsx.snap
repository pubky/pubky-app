exports[`PostInputExpandableSection - Snapshots > matches snapshot when collapsed 1`] = `null`;

exports[`PostInputExpandableSection - Snapshots > matches snapshot when disabled 1`] = `
<div
  class="overflow-hidden "
>
  <div
    class="gap-6"
    data-testid="container"
  >
    <div
      data-testid="post-link-embeds"
    >
      Test
    </div>
    <div
      class="gap-4"
      data-testid="container"
    >
      <div
        data-disabled="true"
        data-testid="post-input-tags"
      />
      <div
        data-has-post-button-icon="false"
        data-hide-article-button="false"
        data-is-article="false"
        data-is-edit="false"
        data-post-button-label="Post"
        data-post-disabled="true"
        data-submitting="false"
        data-testid="post-input-action-bar"
      >
        <button
          data-testid="action-bar-post"
          disabled=""
        >
          Post
        </button>
        <button
          data-testid="action-bar-emoji"
        >
          Emoji
        </button>
        <button
          data-testid="action-bar-article"
        >
          Article
        </button>
      </div>
    </div>
  </div>
</div>
`;

