exports[`PostInputExpandableSection - Snapshots > matches snapshot when expanded with tags 1`] = `
<div
  class="overflow-hidden "
>
  <div
    class="gap-6"
    data-testid="container"
  >
    <div
      data-testid="post-link-embeds"
    >
      Test content
    </div>
    <div
      class="flex flex-wrap items-center gap-2"
      data-override-defaults="true"
      data-testid="container"
    >
      <div
        data-testid="post-tag"
      >
        tag1
        <button
          data-testid="tag-close-tag1"
        >
          ×
        </button>
      </div>
      <div
        data-testid="post-tag"
      >
        tag2
        <button
          data-testid="tag-close-tag2"
        >
          ×
        </button>
      </div>
    </div>
    <div
      class="gap-4"
      data-testid="container"
    >
      <div
        data-disabled="false"
        data-testid="post-input-tags"
      >
        <span>
          tag1
        </span>
        <span>
          tag2
        </span>
