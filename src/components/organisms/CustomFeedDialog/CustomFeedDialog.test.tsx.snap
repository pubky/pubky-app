      data-testid="container"
    >
      <div
        class="flex flex-col gap-y-2"
        data-override-defaults="true"
        data-testid="reach-filter-section"
      >
        <label
          class="text-xs tracking-wide text-muted-foreground uppercase"
          data-testid="label"
        >
          Reach
        </label>
        <div
          data-disabled="false"
          data-testid="reach-select"
          data-value="3"
        >
          <div
            class="w-full sm:w-fit"
            data-testid="select-trigger"
          >
            <span
              data-testid="select-value"
            >
              Select a reach
            </span>
          </div>
          <div
            data-testid="select-content"
          >
            <div
              data-testid="select-item-3"
              data-value="3"
            >
              <svg
                data-testid="icon"
              />
               
              All
            </div>
            <div
              data-testid="select-item-0"
              data-value="0"
            >
              <svg
                data-testid="icon"
              />
               
              Following
            </div>
            <div
              data-testid="select-item-2"
              data-value="2"
            >
              <svg
                data-testid="icon"
              />
               
              Friends
            </div>
          </div>
          <input
            aria-hidden="true"
            data-testid="reach-select-hidden-input"
            hidden=""
            type="text"
            value="3"
          />
        </div>
      </div>
      <div
        class="flex flex-col gap-y-2"
        data-override-defaults="true"
        data-testid="sort-filter-section"
      >
        <label
