              Videos
            </div>
            <div
              data-testid="select-item-4"
              data-value="4"
            >
              <svg
                data-testid="icon"
              />
               
              Links
            </div>
            <div
              data-testid="select-item-5"
              data-value="5"
            >
              <svg
                data-testid="icon"
              />
               
              Files
            </div>
          </div>
          <input
            aria-hidden="true"
            data-testid="content-select-hidden-input"
            hidden=""
            type="text"
            value="0"
          />
        </div>
      </div>
    </div>
    <div
      class="gap-y-2"
      data-testid="container"
    >
      <label
        class="text-xs tracking-wide text-muted-foreground uppercase"
        data-testid="label"
      >
        Filter on Content Tags
      </label>
      <div
        class="w-48"
        data-current-tags-count="2"
        data-disabled="false"
        data-max-tags="5"
        data-testid="feed-tag-input"
      >
        <input
          data-testid="tag-input-field"
        />
        <span
          data-testid="existing-tag-0"
        >
          bitcoin
        </span>
        <span
          data-testid="existing-tag-1"
        >
          lightning
        </span>
      </div>
      <div
        class="flex-row flex-wrap gap-2"
        data-testid="container"
      >
        <span
          data-show-close="true"
          data-testid="post-tag-bitcoin"
        >
          bitcoin
          <button
            data-testid="remove-tag-bitcoin"
          >
            ×
          </button>
        </span>
        <span
          data-show-close="true"
          data-testid="post-tag-lightning"
        >
          lightning
          <button
            data-testid="remove-tag-lightning"
          >
            ×
          </button>
        </span>
      </div>
    </div>
    <div
      data-testid="dialog-footer"
    >
      <button
        class="h-15 w-full"
        data-size="lg"
        data-testid="save-feed-button"
        data-variant="secondary"
      >
        <svg
          class="size-4"
          data-testid="icon"
        />
        Save Feed
      </button>
      <button
        class="h-15 w-full"
        data-size="lg"
        data-testid="delete-feed-button"
        data-variant="destructive"
      >
        <svg
          class="size-4"
          data-testid="icon"
        />
        Delete Feed
      </button>
    </div>
  </div>
</div>
`;

