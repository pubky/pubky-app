exports[`RepostHeader - Snapshots > matches snapshot 1`] = `
<div
  class="flex items-center gap-3 rounded-t-md bg-muted px-4 py-3"
  data-override-defaults="true"
  data-testid="repost-header"
>
  <svg
    aria-label="Repeat"
    class="lucide lucide-repeat size-5"
    fill="none"
    height="24"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width="2"
    viewBox="0 0 24 24"
    width="24"
