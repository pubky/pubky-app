    />
    <path
      d="m7 22-4-4 4-4"
    />
    <path
      d="M21 13v1a4 4 0 0 1-4 4H3"
    />
  </svg>
  <span
    class="text-base font-bold text-foreground"
    data-testid="typography"
  >
    You reposted
  </span>
  <button
    aria-busy="false"
    class="inline-flex items-center justify-center whitespace-nowrap transition-all disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg:not([class*=\\"size-\\"])]:size-4 shrink-0 [&_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/40 aria-invalid:border-destructive font-semibold cursor-pointer rounded-full border shadow-xs h-8 px-3 has-[>svg]:px-3.5 gap-2 border-card bg-card text-xs text-foreground hover:bg-card/90"
    data-cy="repost-undo-btn"
    data-size="sm"
    data-slot="button"
    data-variant="secondary"
    type="button"
  >
    Undo
  </button>
</div>
`;

