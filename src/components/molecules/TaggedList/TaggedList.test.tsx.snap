// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`TaggedList - Snapshots > matches snapshot with empty tags 1`] = `
<div
  class="mx-auto w-full flex-col flex gap-2"
  data-testid="container"
/>
`;

exports[`TaggedList - Snapshots > matches snapshot with tags 1`] = `
<div
  class="mx-auto w-full flex-col flex gap-2"
  data-testid="container"
>
  <div
    data-loading="false"
    data-loading-more="false"
    data-testid="tagged-item"
  >
    bitcoin
    <button
      data-testid="load-more-bitcoin"
    >
      more
    </button>
  </div>
  <div
    data-loading="false"
    data-loading-more="false"
    data-testid="tagged-item"
  >
    satoshi
    <button
      data-testid="load-more-satoshi"
    >
      more
    </button>
  </div>
</div>
`;
