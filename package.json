    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "cypress": "15.10.0",
    "cypress-slow-down": "1.4.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.2",
