{
  "name": "franky",
  "version": "1.8.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "dev:https": "next dev --experimental-https --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next node_modules && npm install",
    "start:e2e": "cypress open -P cypress",
    "start:e2e:mobile": "cypress open -P cypress --config-file cypress.config.mobile.ts",
    "test:e2e": "cypress run -P cypress -b firefox",
    "test:e2e:mobile": "cypress run -P cypress -b firefox --config-file cypress.config.mobile.ts",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:snapshots": "vitest run --project unit --reporter=verbose --testNamePattern=\"[Ss]napshots?\"",
    "test:update-snapshots": "vitest run --project unit --update --testNamePattern=\"[Ss]napshots?\"",
    "test:vrt": "vitest run --project vrt",
    "test:vrt:check-baselines": "bash src/test-utils/vrt.screenshot-siblings.sh",
    "test:vrt:regenerate-baseline": "vitest run --project vrt --update",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\" --ignore-path .prettierignore",
    "precommit": "lint-staged && npm run typecheck",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write --ignore-path .prettierignore"
    ],
    "*.{json,css,md}": "prettier --write --ignore-path .prettierignore"
  },
  "dependencies": {
    "@codemirror/language-data": "6.5.2",
    "@codemirror/theme-one-dark": "6.1.3",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@emoji-mart/data": "1.2.1",
    "@hookform/resolvers": "5.9.1",
    "@mdxeditor/editor": "4.2.3",
    "@mdxeditor/gurx": "1.2.4",
    "@prelude.so/js-sdk": "0.14.0",
    "@sentry/nextjs": "10.71.0",
    "@serwist/next": "9.5.12",
    "@synonymdev/pubky": "0.8.0",
    "@tanstack/react-query": "5.102.8",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "bip39": "3.1.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.4",
    "dexie": "4.4.2",
    "dexie-react-hooks": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "emoji-mart": "5.6.0",
    "facehash": "0.1.0",
    "jszip": "3.10.1",
    "libphonenumber-js": "1.13.12",
    "linkify-it": "5.0.2",
    "lodash-es": "4.18.1",
    "lucide-react": "1.40.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-markdown": "2.1.2",
    "micromark-extension-gfm": "3.0.0",
    "motion": "12.39.0",
    "next": "16.2.6",
    "pubky-app-specs": "0.7.0",
    "qrcode.react": "4.2.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-easy-crop": "5.5.7",
    "react-error-boundary": "6.1.4",
    "react-hook-form": "7.87.0",
    "react-markdown": "10.1.0",
    "react-syntax-highlighter": "16.1.1",
    "react-tweet": "3.3.1",
    "remark-gfm": "4.0.1",
    "serwist": "9.5.12",
    "sharp": "0.35.4",
    "undici": "7.29.0",
    "unist-util-visit": "5.1.0",
    "usehooks-ts": "3.1.1",
    "vitest": "4.1.11",
    "zod": "4.5.4",
    "zustand": "5.0.15"
