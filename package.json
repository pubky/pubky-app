{
  "name": "franky",
  "version": "1.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "dev:https": "next dev --experimental-https --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next node_modules && npm install",
    "start:e2e": "cypress open -P cypress",
    "start:e2e:mobile": "cypress open -P cypress --config-file cypress.config.mobile.ts",
    "test:e2e": "cypress run -P cypress -b firefox",
    "test:e2e:mobile": "cypress run -P cypress -b firefox --config-file cypress.config.mobile.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:snapshots": "vitest run --reporter=verbose --testNamePattern=\"[Ss]napshots?\"",
    "test:update-snapshots": "vitest run --update --testNamePattern=\"[Ss]napshots?\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\" --ignore-path .prettierignore",
    "precommit": "lint-staged && npm run typecheck",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write --ignore-path .prettierignore"
    ],
    "*.{json,css,md}": "prettier --write --ignore-path .prettierignore"
  },
  "dependencies": {
    "@codemirror/theme-one-dark": "6.1.3",
    "@emoji-mart/data": "1.2.1",
    "@hookform/resolvers": "5.2.2",
    "@mdxeditor/editor": "4.0.0",
    "@prelude.so/js-sdk": "0.8.0",
    "@sentry/nextjs": "^10.53.1",
    "@serwist/next": "9.5.11",
    "@swc/helpers": "0.5.21",
    "@synonymdev/pubky": "0.8.0",
    "@tanstack/react-query": "5.100.11",
    "bip39": "3.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.2.1",
    "dexie": "4.4.2",
    "dexie-react-hooks": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "emoji-mart": "5.6.0",
    "facehash": "0.1.0",
    "jszip": "3.10.1",
    "libphonenumber-js": "1.13.2",
    "linkify-it": "5.0.0",
    "lodash-es": "4.18.1",
    "lucide-react": "1.16.0",
    "motion": "12.39.0",
    "next": "16.2.6",
    "next-intl": "4.12.0",
    "next-themes": "0.4.6",
    "pubky-app-specs": "0.4.4",
    "qrcode.react": "4.2.0",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-easy-crop": "5.5.7",
    "react-error-boundary": "6.1.1",
    "react-hook-form": "7.76.0",
    "react-markdown": "10.1.0",
    "react-syntax-highlighter": "16.1.1",
    "react-tweet": "3.3.0",
    "remark-gfm": "4.0.1",
    "serwist": "9.5.11",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "unist-util-visit": "5.1.0",
    "usehooks-ts": "3.1.1",
    "zod": "4.4.3",
    "zustand": "5.0.13"
  },
  "overrides": {
    "intersection-observer": "npm:empty-module@*",
    "source-map@0.8.0-beta.0": "0.7.4",
    "glob": "13.0.1"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@eslint/eslintrc": "3.3.5",
    "@faker-js/faker": "10.4.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/postcss": "4.3.0",
    "@tailwindcss/typography": "0.5.19",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/linkify-it": "5.0.0",
    "@types/lodash-es": "4.17.12",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@types/react-syntax-highlighter": "15.5.13",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.6",
    "babel-plugin-react-compiler": "1.0.0",
    "cypress": "15.10.0",
    "cypress-slow-down": "1.3.1",
    "dotenv": "17.3.1",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "fake-indexeddb": "6.2.5",
    "husky": "9.1.7",
    "jsdom": "28.1.0",
    "lint-staged": "16.4.0",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "tailwindcss": "4.2.0",
    "ts-node": "10.9.2",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.6"
  }
}
