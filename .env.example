# =============================================================================
# Build-Time Values
# =============================================================================
# These values are intrinsic to the built artifact or local browser storage model.
# They are intentionally still NEXT_PUBLIC_* and may be baked into the bundle.

NEXT_PUBLIC_DB_NAME=franky
NEXT_PUBLIC_DB_VERSION=3
NEXT_PUBLIC_DEBUG_MODE=false

# =============================================================================
# Local Dev/Test Runtime-Config Fallbacks
# =============================================================================
# These NEXT_PUBLIC_* names are fallback inputs for `npm run dev` and tests only.
# Deployed/public Docker environments must use the PUBKY_RUNTIME_* block below.
# Next.js inlines NEXT_PUBLIC_* at build time, so these cannot be deployment config.

# Network fallback defaults (staging)
NEXT_PUBLIC_HOMESERVER=ufibwbmed6jeq9k4p583go95wofakh9fwpp4k734trq79pd9u1uy
NEXT_PUBLIC_HOMESERVER_URL=https://homeserver.staging.pubky.app
NEXT_PUBLIC_NEXUS_URL=https://nexus.staging.pubky.app
NEXT_PUBLIC_CDN_URL=https://nexus.staging.pubky.app/static
NEXT_PUBLIC_HOMEGATE_URL=https://homegate.staging.pubky.app
NEXT_PUBLIC_DEFAULT_HTTP_RELAY=https://httprelay.staging.pubky.app/inbox
NEXT_PUBLIC_PKARR_RELAYS=["https://pkarr.pubky.app","https://pkarr.pubky.org"]
NEXT_PUBLIC_TESTNET=false

# Operational fallback defaults
NEXT_PUBLIC_NOTIFICATION_POLL_INTERVAL_MS=8888
NEXT_PUBLIC_NOTIFICATION_POLL_ON_START=true
NEXT_PUBLIC_NOTIFICATION_RESPECT_PAGE_VISIBILITY=true
NEXT_PUBLIC_STREAM_POLL_INTERVAL_MS=8888
NEXT_PUBLIC_STREAM_POLL_ON_START=false
NEXT_PUBLIC_STREAM_RESPECT_PAGE_VISIBILITY=true
NEXT_PUBLIC_STREAM_FETCH_LIMIT=10
NEXT_PUBLIC_STREAM_CACHE_MAX_AGE_MS=300000
NEXT_MAX_STREAM_TAGS=5
NEXT_PUBLIC_TTL_POST_MS=300000
NEXT_PUBLIC_TTL_USER_MS=600000
NEXT_PUBLIC_TTL_BATCH_INTERVAL_MS=5000
NEXT_PUBLIC_TTL_POST_MAX_BATCH_SIZE=20
NEXT_PUBLIC_TTL_USER_MAX_BATCH_SIZE=20
NEXT_PUBLIC_TTL_RETRY_DELAY_MS=60000

# Deployer-facing public fallback defaults
NEXT_PUBLIC_MODERATION_ID=euwmq57zefw5ynnkhh37b3gcmhs7g3cptdbw1doaxj1pbmzp3wro
NEXT_PUBLIC_MODERATED_TAGS=["nudity"]
NEXT_PUBLIC_EXCHANGE_RATE_API=https://api1.blocktank.to/api/fx/rates/btc
# NEXT_PUBLIC_PRELUDE_SDK_KEY=your_prelude_sdk_key_here
# NEXT_PUBLIC_PRELUDE_SDK_TIMEOUT_MS=5000
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=pubky.app
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://_analytics.synonym.to/js/script.js
# NEXT_PUBLIC_PREVIEW_IMAGE=/preview.webp
# NEXT_PUBLIC_SITE_NAME=Pubky App
# NEXT_PUBLIC_LOCALE=en_US
# NEXT_PUBLIC_AUTHOR=Pubky Team
# NEXT_PUBLIC_KEYWORDS=pubky, social media, decentralized, key, pkarr, pubky core
# NEXT_PUBLIC_TYPE=website
# NEXT_PUBLIC_CREATOR=@getpubky
# NEXT_PUBLIC_DEFAULT_URL=https://pubky.app
# NEXT_PUBLIC_PUBKY_RING_URL=https://pubkyring.app/
# NEXT_PUBLIC_PUBKY_CORE_URL=https://pubky.org
# NEXT_PUBLIC_TWITTER_URL=https://x.com/pubky
# NEXT_PUBLIC_TWITTER_GETPUBKY_URL=https://x.com/getpubky
# NEXT_PUBLIC_TELEGRAM_URL=https://t.me/pubkychat
# NEXT_PUBLIC_GITHUB_URL=https://github.com/pubky
# NEXT_PUBLIC_EMAIL=hello@pubky.com
# NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/pubky-ring/id6739356756
# NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=to.pubky.ring&pcampaignid=web_share

# Optional Sentry fallback for local dev/test only.
# Empty/unset DSN disables Sentry.
# NEXT_PUBLIC_SENTRY_DSN=https://eba463f14570a9ce3b3bd831d3d7fa34@o4510935258234880.ingest.de.sentry.io/4510935265640528
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.0
# NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# Local testnet fallback example
# NEXT_PUBLIC_HOMESERVER=8pinxxgqs41n4aididenw5apqp1urfmzdztr8jt4abrkdn435ewo
# NEXT_PUBLIC_HOMESERVER_URL=http://localhost:6286
# NEXT_PUBLIC_NEXUS_URL=http://localhost:8080
# NEXT_PUBLIC_TESTNET=true
# NEXT_PUBLIC_DEFAULT_HTTP_RELAY=http://localhost:15412/inbox/

# =============================================================================
# Runtime Configuration (PUBKY_RUNTIME_*) - Deployed/Public Docker
# =============================================================================
# PUBLIC values (NOT secrets): supplied at CONTAINER RUNTIME (Ansible / Docker
# Compose / Kubernetes / Cloud Run). These are read by the server and injected
# into `window.__PUBKY_CONFIG__`.
#
# `npm run dev` can use the NEXT_PUBLIC_* fallback block above.
# `npm run build && npm run start` runs as NODE_ENV=production, so it requires
# the eight network values below unless you are in a Next production-build phase.
#
# Set PUBKY_RUNTIME_CONFIG_REQUIRED=true to force strict runtime config under
# `npm run dev` too.

# Required network tier (all eight required together in deployed/required mode)
# PUBKY_RUNTIME_NEXUS_URL=https://nexus.staging.pubky.app
# PUBKY_RUNTIME_CDN_URL=https://nexus.staging.pubky.app/static
# PUBKY_RUNTIME_HOMESERVER=ufibwbmed6jeq9k4p583go95wofakh9fwpp4k734trq79pd9u1uy
# PUBKY_RUNTIME_HOMESERVER_URL=https://homeserver.staging.pubky.app
# PUBKY_RUNTIME_HOMEGATE_URL=https://homegate.staging.pubky.app
# PUBKY_RUNTIME_DEFAULT_HTTP_RELAY=https://httprelay.staging.pubky.app/inbox
# PUBKY_RUNTIME_PKARR_RELAYS=["https://pkarr.pubky.app","https://pkarr.pubky.org"]
# PUBKY_RUNTIME_TESTNET=false

# Optional Sentry tier (absent DSN disables Sentry)
# PUBKY_RUNTIME_SENTRY_DSN=https://examplekey@o0.ingest.sentry.io/0
# PUBKY_RUNTIME_SENTRY_ENVIRONMENT=production
# PUBKY_RUNTIME_SENTRY_TRACES_SAMPLE_RATE=0.1
# PUBKY_RUNTIME_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.0
# PUBKY_RUNTIME_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# Optional/defaulted public runtime config. Omit values to use the defaults from
# src/libs/runtime-config/runtime-config.schema.ts. Malformed provided values
# fail loudly during runtime config resolution.
# PUBKY_RUNTIME_NOTIFICATION_POLL_INTERVAL_MS=8888
# PUBKY_RUNTIME_NOTIFICATION_POLL_ON_START=true
# PUBKY_RUNTIME_NOTIFICATION_RESPECT_PAGE_VISIBILITY=true
# PUBKY_RUNTIME_STREAM_POLL_INTERVAL_MS=8888
# PUBKY_RUNTIME_STREAM_POLL_ON_START=false
# PUBKY_RUNTIME_STREAM_RESPECT_PAGE_VISIBILITY=true
# PUBKY_RUNTIME_STREAM_FETCH_LIMIT=10
# PUBKY_RUNTIME_STREAM_CACHE_MAX_AGE_MS=300000
# PUBKY_RUNTIME_MAX_STREAM_TAGS=5
# PUBKY_RUNTIME_TTL_POST_MS=300000
# PUBKY_RUNTIME_TTL_USER_MS=600000
# PUBKY_RUNTIME_TTL_BATCH_INTERVAL_MS=5000
# PUBKY_RUNTIME_TTL_POST_MAX_BATCH_SIZE=20
# PUBKY_RUNTIME_TTL_USER_MAX_BATCH_SIZE=20
# PUBKY_RUNTIME_TTL_RETRY_DELAY_MS=60000
# PUBKY_RUNTIME_MODERATION_ID=euwmq57zefw5ynnkhh37b3gcmhs7g3cptdbw1doaxj1pbmzp3wro
# PUBKY_RUNTIME_MODERATED_TAGS=["nudity"]
# PUBKY_RUNTIME_EXCHANGE_RATE_API=https://api1.blocktank.to/api/fx/rates/btc
# PUBKY_RUNTIME_PRELUDE_SDK_KEY=your_prelude_sdk_key_here
# PUBKY_RUNTIME_PRELUDE_SDK_TIMEOUT_MS=5000
# PUBKY_RUNTIME_PLAUSIBLE_DOMAIN=pubky.app
# PUBKY_RUNTIME_PLAUSIBLE_SCRIPT_URL=https://_analytics.synonym.to/js/script.js
# PUBKY_RUNTIME_PREVIEW_IMAGE=/preview.webp
# PUBKY_RUNTIME_SITE_NAME=Pubky App
# PUBKY_RUNTIME_LOCALE=en_US
# PUBKY_RUNTIME_AUTHOR=Pubky Team
# PUBKY_RUNTIME_KEYWORDS=pubky, social media, decentralized, key, pkarr, pubky core
# PUBKY_RUNTIME_TYPE=website
# PUBKY_RUNTIME_CREATOR=@getpubky
# PUBKY_RUNTIME_DEFAULT_URL=https://pubky.app
# PUBKY_RUNTIME_PUBKY_RING_URL=https://pubkyring.app/
# PUBKY_RUNTIME_PUBKY_CORE_URL=https://pubky.org
# PUBKY_RUNTIME_TWITTER_URL=https://x.com/pubky
# PUBKY_RUNTIME_TWITTER_GETPUBKY_URL=https://x.com/getpubky
# PUBKY_RUNTIME_TELEGRAM_URL=https://t.me/pubkychat
# PUBKY_RUNTIME_GITHUB_URL=https://github.com/pubky
# PUBKY_RUNTIME_EMAIL=hello@pubky.com
# PUBKY_RUNTIME_APP_STORE_URL=https://apps.apple.com/app/pubky-ring/id6739356756
# PUBKY_RUNTIME_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=to.pubky.ring&pcampaignid=web_share

# =============================================================================
# Development Only - Homeserver Admin Credentials
# =============================================================================
# For local development and E2E testing only. Do not set these in production.
# The token-generation API route is blocked in production.
# HOMESERVER_ADMIN_URL=http://localhost:6288/generate_signup_token
# HOMESERVER_ADMIN_PASSWORD=admin

# =============================================================================
# Support/Chatwoot Configuration (server-side)
# =============================================================================
# Server-side only. These are not exposed to the browser as NEXT_PUBLIC_*.
BASE_URL_SUPPORT=https://chatwoot.example.com
SUPPORT_API_ACCESS_TOKEN=your_token_here
SUPPORT_ACCOUNT_ID=123
SUPPORT_FEEDBACK_INBOX_ID=26

# =============================================================================
# Sentry Source Map Upload (CI/build only)
# =============================================================================
# SENTRY_AUTH_TOKEN / SENTRY_ORG / SENTRY_PROJECT are optional Docker build inputs
# used only for source-map upload. They are not runtime app config and are not
# needed to run the public image.
